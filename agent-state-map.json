          "scope": "runtime",
          "format": "text",
          "kind": "resume-pointer",
          "transfer": "rebuild",
          "sensitivity": "private",
          "stability": "documented"
        },
        {
          "id": "credentials-and-secrets",
          "paths": ["<user>/agent.db::auth_*", "<user>/secrets.yml", "<project>/.omp/secrets.yml", "<user>/secret-placeholder.key"],
          "scope": "user-and-project",
          "format": "sqlite-yaml-key",
          "kind": "credentials",
          "transfer": "exclude",
          "sensitivity": "secret",
          "stability": "documented"
        },
        {
          "id": "logs-caches-and-model-indexes",
          "paths": ["~/.omp/logs/", "<user>/cache/", "<user>/models.db"],
          "scope": "user",
