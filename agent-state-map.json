            "existing XDG_DATA_HOME/XDG_STATE_HOME/XDG_CACHE_HOME omp roots"
          ]
        },
        {
          "id": "project",
          "default": "<project>/.omp"
        }
      ],
      "artifacts": [
        {
          "id": "global-settings",
          "paths": ["<user>/config.yml", "<user>/config.yaml", "<user>/settings.json.bak"],
          "scope": "user",
          "format": "yaml-or-legacy-json",
          "kind": "configuration",
          "transfer": "translate",
          "sensitivity": "mixed",
          "stability": "documented",
          "notes": "Allowlist non-secret settings. settings.json is legacy after migration."
        },
        {
          "id": "project-settings",
          "paths": ["<project>/.omp/config.yml", "<project>/.omp/settings.json"],
          "scope": "project",
          "format": "yaml-or-json",
