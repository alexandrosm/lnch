          "stability": "internal"
        }
      ],
      "sessionInterop": {
        "resume": ["omp --continue", "omp --resume [id|path]", "omp --fork <id|path>"],
        "nativeImports": [
          {
            "from": "claude",
            "commands": ["omp --from-claude", "/resume @claude"],
            "fidelity": "Preserves main-chain user/assistant text, images, thinking with signatures, tool calls/results, timestamps, parent tree, model changes, and title. Drops meta and sidechain records."
          },
          {
            "from": "codex",
            "commands": ["omp --from-codex", "/resume @codex"],
            "fidelity": "Preserves supported messages, reasoning, function/custom/MCP/web tool calls and results, model changes, rollback effects, titles, and Codex remote compaction state."
          }
        ],
        "nativeExports": ["/export produces HTML", "/dump produces display text and a best-effort JSON sidecar"],
        "preferredSource": "Read raw OMP JSONL plus referenced blobs for machine migration; HTML is presentation-only."
      },
      "evidence": [
        "https://github.com/can1357/oh-my-pi/blob/main/docs/session.md",
        "https://github.com/can1357/oh-my-pi/blob/main/docs/config-usage.md",
