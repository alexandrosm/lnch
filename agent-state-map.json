{
  "schema": 1,
  "reviewedAt": "2026-08-26",
  "purpose": "Discovery metadata for safe agent-to-agent migration planning. This file describes where agents keep state; it does not authorize copying every artifact.",
  "transferPolicies": {
    "native": "Prefer the source or target agent's supported import/export command.",
    "translate": "Read the source artifact and convert its semantics into a versioned canonical model.",
    "project-shared": "Keep the artifact in the project and reference it; do not duplicate it into another private store.",
    "read-only-index": "Use only to discover or validate canonical artifacts. Never transplant or mutate it.",
    "evidence": "Preserve only as optional filesystem or Git evidence, separate from conversational history.",
    "rebuild": "Do not migrate. Let the target agent regenerate it.",
    "exclude": "Never include in a migration bundle. Re-authenticate or reconfigure explicitly."
  },
  "invariants": [
    "Never copy API keys, OAuth tokens, refresh tokens, credential databases, keychains, .env contents, or secret-placeholder keys.",
    "Treat every transcript, prompt-history file, tool result, attachment, memory, and checkpoint as potentially secret-bearing.",
    "Never write directly into another agent's private session store or mutable index.",
    "Read SQLite through a consistent read-only snapshot or backup while the owning agent is closed; do not copy live WAL sets piecemeal.",
    "Use indexes only to locate canonical transcript files; a stale or missing index must not erase discoverable transcripts.",
    "Translate approval, sandbox, hook, MCP, and provider settings semantically. Never copy a permissive source setting blindly.",
    "Start the target as a fresh session unless its documented importer creates a valid target-native session.",
    "Emit provenance and an explicit loss report for every translated session."
  ],
  "knownGaps": [
    "Only OMP, Claude Code, and Codex were installed locally during this review; Gemini CLI, Aider, OpenCode, and Qwen Code were mapped from current official documentation and upstream source.",
    "Private formats and versioned SQLite schemas can change without compatibility guarantees. Adapter selection must be version-gated and fixture-tested.",
    "Provider-encrypted reasoning, signatures, prompt-cache identifiers, and account-affinity metadata are not portable. Preserve only opaque provenance when safe; never replay them as target credentials.",
    "Tool names, argument schemas, result envelopes, and call IDs differ. Unknown tools require a loss entry and a bounded textual representation.",
    "Encoded project paths and recorded cwd values are machine-specific. Migration needs explicit path rebasing and must never infer trust from the source machine.",
    "Attachments, blob payloads, tool-result spills, and checkpoints may already be absent because of retention cleanup. Missing referenced data must be reported, not silently dropped.",
    "OMP and Codex foreign importers are one-way and intentionally selective. Their exact fidelity still needs golden cross-version fixtures.",
    "Aider's restorable Markdown history omits structured tool semantics and drops quoted tool-role messages by default.",
    "OpenCode's current SQLite database mixes portable conversation rows with credential and account tables. Prefer its native export command.",
    "Imported hooks, plugins, commands, skills, MCP servers, and permission rules can execute code or widen access; require item-level review before activation."
  ],
  "agents": {
    "omp": {
      "displayName": "Oh My Pi",
      "verification": {
        "mode": "installed-and-upstream-source",
